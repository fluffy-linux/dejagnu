# Test 'which' in lib/utils.exp with wildcard PATH entries.	-*- Tcl -*-
#
# Fluffy Linux late-binds PATH through glob patterns such as /sw/*/bin.
# These tests build their own fixture tree under a temporary directory,
# so they do not depend on the host's /sw, /usr or /bin.

if [ file exists $srcdir/$subdir/default_procs.tcl ] {
    source $srcdir/$subdir/default_procs.tcl
} else {
    puts "ERROR: $srcdir$subdir/default_procs.tcl doesn't exist"
}

set file $srcdir/../lib/utils.exp
if [ file exists $file] {
    source $file
} else {
    puts "ERROR: $file doesn't exist"
}

set td [exec mktemp -d]
set d_sw  [file join $td sw pkg bin]
set d_bkt [file join $td {1:pkg} bin]
set d_bs  [file join $td "dir_bs\\"]
set d_lit [file join $td "lit\[1\]" bin]
set d_li1 [file join $td "lit1" bin]
set d_br  [file join $td {br{a,b}} pkg bin]
file mkdir $d_sw $d_bkt $d_bs $d_lit $d_li1 $d_br
foreach {d fn} [list $d_sw fluffy_cc $d_bkt dj_probe \
		    $d_lit lit_probe $d_li1 lit_probe $d_br br_probe] {
    set fp [file join $d $fn]
    set fd [open $fp w]
    puts $fd "stub"
    close $fd
    file attributes $fp -permissions 0755
}

set saved_path $env(PATH)

# A PATH made only of a wildcard entry, like PATH=/sw/*/bin.
#
set env(PATH) [file join $td sw * bin]
if {[which fluffy_cc] eq [file join $d_sw fluffy_cc]} {
    pass "which, wildcard-only PATH"
} else {
    fail "which, wildcard-only PATH"
}

# An empty entry, a literal directory ending in a backslash, a literal
# directory containing brackets, a wildcard entry with literal braces,
# a bracket expression containing a colon, and a trailing wildcard entry.
#
set env(PATH) [format ":%s:%s:%s/%s/*/bin:%s/%s/bin:%s/sw/*/bin" \
		   $d_bs $d_lit $td {br{a,b}} $td {1[a:]pkg} $td]

if {[which dj_probe] eq [file join $d_bkt dj_probe]} {
    pass "which, colon inside a bracket expression does not split PATH"
} else {
    fail "which, colon inside a bracket expression does not split PATH"
}

if {[which lit_probe] eq [file join $d_lit lit_probe]} {
    pass "which, existing literal directory with brackets wins over its glob match"
} else {
    fail "which, existing literal directory with brackets wins over its glob match"
}

if {[which br_probe] eq [file join $d_br br_probe]} {
    pass "which, braces in a wildcard PATH entry are literal"
} else {
    fail "which, braces in a wildcard PATH entry are literal"
}

if {[which fluffy_cc] eq [file join $d_sw fluffy_cc]} {
    pass "which, trailing wildcard PATH entry after escapes"
} else {
    fail "which, trailing wildcard PATH entry after escapes"
}

# Bracket expressions whose first character is "]" (after an optional
# "!" or "^") keep that "]" and any ":" after it inside the entry: split
# there, the PATH would gain the relative entry "]pkg/bin", which the
# fixture provides under the working directory.
#
set saved_pwd [pwd]
cd $td
set d_rel [file join $td {]pkg} bin]
file mkdir $d_rel
set fd [open [file join $d_rel rb_probe] w]; puts $fd "stub"; close $fd
file attributes [file join $d_rel rb_probe] -permissions 0755

set env(PATH) [file join $td {f[]:]pkg} bin]
if {[which rb_probe] == 0} {
    pass "which, ] first in a bracket expression does not end it"
} else {
    fail "which, ] first in a bracket expression does not end it"
}

set env(PATH) [file join $td {f[!]:]pkg} bin]
if {[which rb_probe] == 0} {
    pass "which, ] after ! in a bracket expression does not end it"
} else {
    fail "which, ] after ! in a bracket expression does not end it"
}

# A character class such as [:alpha:] inside a bracket expression: its
# colons do not split PATH (split there, "alpha" would be an entry).
#
set d_cls [file join $td alpha]
file mkdir $d_cls
set fd [open [file join $d_cls cls_probe] w]; puts $fd "stub"; close $fd
file attributes [file join $d_cls cls_probe] -permissions 0755

set env(PATH) [file join $td {[[:alpha:]]x} bin]
if {[which cls_probe] == 0} {
    pass "which, a character class's colons do not split PATH"
} else {
    fail "which, a character class's colons do not split PATH"
}

# An unterminated class stops at "/"; the next ":" still splits.
#
set env(PATH) [format "%s/g\[\[:x/bin:%s/sw/*/bin" $td $td]
if {[which fluffy_cc] eq [file join $d_sw fluffy_cc]} {
    pass "which, an unterminated character class ends at /"
} else {
    fail "which, an unterminated character class ends at /"
}
cd $saved_pwd

# A wildcard entry starting with "~" is not tilde-expanded (no such user
# is an error for glob, not a match).
#
set env(PATH) "~fluffy-no-such-user*/bin"
if {[which fluffy_cc] == 0} {
    pass "which, wildcard entry starting with ~ is not tilde-expanded"
} else {
    fail "which, wildcard entry starting with ~ is not tilde-expanded"
}

# A file that a wildcard entry finds but that is not executable is skipped.
#
set fd [open [file join $d_sw noexec_probe] w]; puts $fd "stub"; close $fd
file attributes [file join $d_sw noexec_probe] -permissions 0644
set env(PATH) [file join $td sw * bin]
if {[which noexec_probe] == 0} {
    pass "which, non-executable file in a wildcard entry is skipped"
} else {
    fail "which, non-executable file in a wildcard entry is skipped"
}

set env(PATH) $saved_path
file delete -force $td

puts "END utils_which.test"
